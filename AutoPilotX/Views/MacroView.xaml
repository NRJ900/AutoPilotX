<UserControl x:Class="AutoPilotX.Views.MacroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AutoPilotX.Views"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:viewModels="clr-namespace:AutoPilotX.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <viewModels:MacroViewModel/>
    </UserControl.DataContext>
    <StackPanel Margin="20">
        <Button Content="Start Recording" Command="{Binding StartRecordingCommand}" />
        <Button Content="Stop Recording" Command="{Binding StopRecordingCommand}" Margin="0,10,0,0" />
        <Button Content="Play Macro" Command="{Binding PlayMacroCommand}" Margin="0,10,0,0" />
        <TextBox Text="{Binding MacroName}" Margin="0,10,0,0}" />
        <Button Content="Save Macro" Command="{Binding SaveMacroCommand}" Margin="0,10,0,0}" />
        <ListView ItemsSource="{Binding MacroEvents}" Margin="0,10,0,0}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Event Type" DisplayMemberBinding="{Binding EventType}" />
                    <GridViewColumn Header="X" DisplayMemberBinding="{Binding X}" />
                    <GridViewColumn Header="Y" DisplayMemberBinding="{Binding Y}" />
                    <GridViewColumn Header="Key Code" DisplayMemberBinding="{Binding KeyCode}" />
                    <GridViewColumn Header="Timestamp" DisplayMemberBinding="{Binding Timestamp}" />
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</UserControl>
